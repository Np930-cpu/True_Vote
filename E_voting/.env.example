# ==========================================
# TrueVote Django Backend Environment Config
# Copy this file to .env and fill in real values
# ==========================================

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.onrender.com

# Database (Option 1: Single DATABASE_URL connection string from cloud provider)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Database (Option 2: Individual connection parameters)
DB_NAME=vote_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Email Settings (for OTP verification)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_gmail_app_password

# Security & CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.vercel.app
